/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self'; upgrade-insecure-requests

/admin.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive

/admin-downloads.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive

/manuals.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive

/api/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive

/docs/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive
